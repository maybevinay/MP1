<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-900 flex items-center justify-center min-h-screen">
  <form action="/login" method="POST" class="bg-gray-800 p-6 rounded-lg shadow-lg w-full max-w-md text-white space-y-4">
    <h2 class="text-2xl font-bold text-center mb-4">Login</h2>

    <input type="email" placeholder="Email" name="email"
      class="w-full p-2 rounded-md bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">

    <input type="password" placeholder="Password" name="password"
      class="w-full p-2 rounded-md bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">


    <input type="submit" value="Login"
      class="w-full bg-blue-600 p-2 rounded-md cursor-pointer hover:bg-blue-700 transition duration-300">
  </form>
</body>
</html>


